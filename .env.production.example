# Production environment for docker-compose.
#   cp .env.production.example .env   (on the server)
# Then fill in the real values. NEVER commit the resulting .env.

# Public domain. Its DNS A record must already point to this server so Caddy can
# obtain a TLS certificate on first start.
DOMAIN=portfolio.catalystlabs.id

# LLM API key — required for chat, proactive sends, and ingestion. Holds the
# DeepSeek key by default (variable name kept for backward compatibility).
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Text model + endpoint for chat and proactive sends (Anthropic-Messages shape).
# Default: DeepSeek. Override LLM_BASE_URL to https://api.anthropic.com (and use
# a claude-* LLM_MODEL) to switch back to Claude.
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/anthropic

# Vision model + endpoint for image ingestion (OpenAI chat/completions shape;
# DeepSeek V4 has no vision). Uses OPENAI_API_KEY below. PDFs are not extracted
# (image-only) and are staged for manual re-upload.
INGEST_MODEL=gpt-4o
INGEST_BASE_URL=https://api.openai.com

# Shared secret between the backend and the WhatsApp gateway. Generate one with:
#   openssl rand -hex 32
GATEWAY_TOKEN=replace-with-openssl-rand-hex-32

# Telegram bot token from @BotFather — optional. Leave empty to disable the
# Telegram chatbot channel.
TELEGRAM_BOT_TOKEN=

# Backend log verbosity (tracing env-filter syntax).
RUST_LOG=info

# --- Long-term memory stack (neo4j + memory-service) ---
# OpenAI API key — used by the backend for image ingestion (gpt-4o) AND by
# Graphiti for embedding generation.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Password for the Neo4j graph database. Must be at least 8 characters.
NEO4J_PASSWORD=replace-with-strong-password
# Model used by the memory-service for LLM extraction (optional, defaults to
# deepseek-v4-flash via LLM_BASE_URL). Embeddings still use OpenAI above.
MEMORY_LLM_MODEL=
# Note: MEMORY_SERVICE_URL is wired inside docker-compose.yml (http://memory-service:8000);
# unset it there to turn long-term memory off entirely.

# Proactive sends (all optional; defaults shown). Set an hour to "off" to disable.
BRIEFING_HOUR_WIB=7
RECAP_HOUR_WIB=17
MOVER_ALERT_PCT=5
MILESTONE_STEP_IDR=50000000

# --- Google Calendar sync (optional; leave unset to disable) ---
# OAuth client from Google Cloud Console (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://portfolio.catalystlabs.id/api/google/oauth/callback
# base64 of 32 random bytes: `openssl rand -base64 32`. Required to connect.
GOOGLE_TOKEN_ENC_KEY=

# --- Upwork OAuth sync (optional; leave unset to disable) ---
# OAuth client from the Upwork Developer Portal (Web application).
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Upwork Developer Portal.
UPWORK_REDIRECT_URI=https://portfolio.catalystlabs.id/api/upwork/oauth/callback
# base64 of 32 random bytes: `openssl rand -base64 32`. Required to connect.
UPWORK_TOKEN_ENC_KEY=
