# Production environment for docker-compose.
#   cp .env.production.example .env   (on the server)
# Then fill in the real values. NEVER commit the resulting .env.

# Public domain. Its DNS A record must already point to this server so Caddy can
# obtain a TLS certificate on first start.
DOMAIN=portfolio.catalystlabs.id

# Anthropic API key — required for LLM ingestion and chat.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude model used for ingestion/chat.
INGEST_MODEL=claude-sonnet-4-6

# Shared secret between the backend and the WhatsApp gateway. Generate one with:
#   openssl rand -hex 32
GATEWAY_TOKEN=replace-with-openssl-rand-hex-32

# Backend log verbosity (tracing env-filter syntax).
RUST_LOG=info
