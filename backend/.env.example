# Backend (Rust/axum) — copy to backend/.env
#
#   cp backend/.env.example backend/.env
#
# `make backend` / `make dev` auto-load backend/.env if it is present.

# LLM API key — REQUIRED for chat, proactive messages, and ingestion.
# Holds the DeepSeek API key by default (the variable name is kept for
# backward compatibility — it is sent as the bearer/x-api-key credential to
# whichever endpoint LLM_BASE_URL / LLM_NATIVE_BASE_URL point at).
# Without it, the LLM endpoints return a "no key" error.
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Text model for chat + proactive (briefing/recap), via the Anthropic-Messages
# compatible endpoint. Default deepseek-v4-flash; use deepseek-v4-pro for
# stronger reasoning, or a claude-* id together with LLM_BASE_URL below.
LLM_MODEL=deepseek-v4-flash

# Anthropic-Messages-compatible base URL for the text/chat paths.
# DeepSeek default below; set to https://api.anthropic.com to use Claude.
LLM_BASE_URL=https://api.deepseek.com/anthropic

# Image ingestion runs on a vision-capable provider (DeepSeek V4 has no vision).
# OpenAI key — REQUIRED for image ingestion (and reused by the memory-service
# for embeddings).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vision model + endpoint for image ingestion (OpenAI chat/completions shape).
# PDFs are not extracted (image-only) and are staged for manual re-upload.
INGEST_MODEL=gpt-4o
INGEST_BASE_URL=https://api.openai.com

# Shared secret with the WhatsApp gateway. When set, the gateway must send a
# matching token or its requests are rejected. Leave unset to disable auth on
# the /whatsapp endpoint (local dev only). Must equal the gateway's GATEWAY_TOKEN.
GATEWAY_TOKEN=change-me-to-a-long-random-string

# SQLite database location. The file is created on first run.
DATABASE_URL=sqlite://portfolio.db

# Log verbosity (tracing env-filter syntax, e.g. info, debug, portfolio_tracker=debug).
RUST_LOG=info

# HTTP bind address. NOTE: the Makefile controls this via `make backend BIND_ADDR=...`
# and overrides whatever is set here. Setting it in .env only matters if you run
# `cargo run` directly.
# BIND_ADDR=127.0.0.1:8080

# --- Google Calendar sync (optional; leave unset to disable) ---
# OAuth client from Google Cloud Console (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://portfolio.catalystlabs.id/api/google/oauth/callback
# base64 of 32 random bytes: `openssl rand -base64 32`. Required to connect.
GOOGLE_TOKEN_ENC_KEY=

# --- ClickUp freelance projects (optional; leave unset to disable) ---
# When CLICKUP_API_TOKEN is unset the project/task tools return "clickup belum
# dikonfigurasi" and the briefing's ClickUp section is omitted — the bot still runs.
# Personal API token (ClickUp → Settings → Apps → API Token), looks like `pk_...`.
CLICKUP_API_TOKEN=
# The Space that holds your client projects (lists). Numeric id from the URL.
CLICKUP_SPACE_ID=
# Status name used to mark a task done via complete_task. Default "complete".
# CLICKUP_DONE_STATUS=complete
# Custom-field names read for billable tasks (create these fields in the ClickUp
# UI first; absent fields are skipped). Defaults below.
# CLICKUP_BILLABLE_FIELD=Billable
# CLICKUP_AMOUNT_FIELD=Amount

# --- Invoicing (optional; INVOICE_ISSUER_NAME + INVOICE_ACCOUNT_NO required to enable) ---
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_COMPANY=
INVOICE_ISSUER_WEBSITE=
INVOICE_ISSUER_CITY=Jakarta
INVOICE_BANK=
INVOICE_ACCOUNT_NO=
INVOICE_ACCOUNT_NAME=
# Days until due (default 14).
INVOICE_DUE_DAYS=14

# --- IT news digest (optional; on by default) ---
# Set to "off" to disable generation and both surfaces (briefing + /news page).
NEWS_ENABLED=true
# WIB hour the digest is generated. Default 6, one hour before the default
# briefing (7) so the "Bacaan pagi" section is ready. "off" disables the job.
NEWS_DIGEST_HOUR_WIB=6
# Comma-separated RSS/Atom feeds. Unset = a tailored default set.
NEWS_RSS_FEEDS=
# Max candidates considered before picking the top 3.
NEWS_MAX_CANDIDATES=12
# Quiz questions per digest (target; the LLM may return fewer).
NEWS_QUIZ_COUNT=4

# --- Customer-service chatbot (public widget) ---
# Both must be set together to ENABLE the public /public/cs/* endpoints; leave
# both unset to keep the widget disabled. The backend refuses to start if only
# one is set.
# Comma-separated list of exact origins allowed to embed the widget:
CS_ALLOWED_ORIGINS=https://your-site.com,https://www.your-site.com
# Public site-key the embed script presents (NOT a secret — ships in page JS):
CS_WIDGET_KEY=
# Embedding model for the KB (OpenAI-shape; reuses OPENAI_API_KEY + INGEST_BASE_URL):
CS_EMBED_MODEL=text-embedding-3-small

# CS WhatsApp (Phase 2): shared token for the SECOND (customer-service) gateway.
# Set this AND run a cs-gateway instance pointed at /cs/* to enable WhatsApp CS.
CS_GATEWAY_TOKEN=
