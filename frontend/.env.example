# Frontend (Vite/React) — copy to frontend/.env.local
#
#   cp frontend/.env.example frontend/.env.local
#
# Vite auto-loads .env / .env.local; only VITE_-prefixed vars reach the browser.

# Base path for API calls.
#  - Dev: leave as /api — vite.config.ts proxies /api -> http://localhost:8080.
#  - Prod: set to your deployed backend URL, e.g. https://api.example.com
VITE_API_BASE=/api
