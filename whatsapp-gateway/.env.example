# WhatsApp gateway (Node/Baileys) — copy to whatsapp-gateway/.env
#
#   cp whatsapp-gateway/.env.example whatsapp-gateway/.env
#
# `make gateway` auto-loads whatsapp-gateway/.env if it is present.

# Base URL of the backend API the gateway forwards inbound messages to.
BACKEND_URL=http://localhost:8080

# Shared secret — MUST match the backend's GATEWAY_TOKEN. Leave empty only if the
# backend also has GATEWAY_TOKEN unset (local dev).
GATEWAY_TOKEN=change-me-to-a-long-random-string
